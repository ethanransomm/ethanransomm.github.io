---
// One of the language and tool marks from src/data/icons.ts. It is
// decoration beside a written name, so it is hidden from screen readers.
// An unknown or empty name draws nothing but keeps its place, so a column of
// rows still lines up.
import { icons } from "../data/icons";

interface Props {
  name: string;
}
const glyph = icons[Astro.props.name];
---

<span class="icon" aria-hidden="true">
  {
    glyph && (
      <svg viewBox="0 0 24 24" fill="currentColor" focusable="false" set:html={glyph} />
    )
  }
</span>

<style>
  .icon {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    color: var(--muted);
  }
  svg {
    width: 100%;
    height: 100%;
  }
  /* the lettering inside the lettered marks */
  svg :global(text) {
    font-family: var(--font-mono);
  }
</style>
