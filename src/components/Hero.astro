---
// The masthead as a split: who I am and what I am looking for on the left;
// on the right the dissertation's scans in a window, its headline result as
// bars beneath, and four facts under those.
//
// The picture and the numbers come from the dissertation's own write-up in
// src/content/projects/, so they cannot drift from the project page.
//
// Layout is written with Tailwind utilities. The name's two effects (the
// letter-by-letter entrance and the misregistered colour) are one-offs, so
// they stay as plain CSS at the foot of this file.
import { getEntry } from "astro:content";
import { Image } from "astro:assets";
import ResultBars from "./ResultBars.astro";
import { site } from "../data/site";
// The four scan panels cut out of the slice-viewer screenshot. At the size a
// hero shows a picture, the scans read and the dashboard's small labels do
// not, so the hero shows only the scans. To remake it after replacing the
// screenshot, crop the row of four panels and the "Slice" label under them.
import scans from "../assets/projects/prostate-slice-viewer-scans.webp";

const project = await getEntry("projects", "prostate-mri-dashboard");
const results = project?.data.results;
const scansAlt =
  "Four MRI panels from the dashboard's slice viewer (T2 with heatmap, ADC, DWI and a lesion zoom), each with the model's red predicted boundary and the green ground-truth outline.";
const href = `/projects/${project?.id}/`;

const letters = site.name.split("");
const surnameFrom = site.name.lastIndexOf(" ");

// The facts under the picture: the figure, then what it counts.
const facts = [
  { value: "First Class", label: "BSc Computer Science" },
  { value: "1,500", label: "MRI cases modelled" },
  { value: "3", label: "architectures compared" },
  { value: "96%", label: "top module mark" },
];
---

<section class="hero relative pt-14 pb-10 max-sm:pt-10 max-sm:pb-8" aria-labelledby="name">
  <div class="relative z-[1] grid items-start gap-x-12 gap-y-10 lg:grid-cols-12">
    <!-- who, what, and what to do next -->
    <div class="min-w-0 lg:col-span-5">
      <h1 id="name" class="display name mb-5">
        <span class="sr-only">{site.name}</span>
        <span aria-hidden="true">
          {
            letters.map((ch, i) => (
              <span
                class:list={[
                  "ch",
                  { gap: ch === " ", accent: surnameFrom > 0 && i > surnameFrom },
                ]}
                style={`--c:${i}`}
              >
                {ch === " " ? "\u00a0" : ch}
              </span>
            ))
          }
        </span>
      </h1>

      <p class="m-0 max-w-[34rem] text-lg">{site.tagline}</p>

      <p class="mt-5 mb-0 flex max-w-[34rem] gap-[1ch] font-mono text-sm">
        <span class="flex-none font-semibold text-accent">status</span>
        <span class="font-semibold text-ink [text-wrap:balance]">
          Applying for graduate software, data analytics and ML engineering roles
        </span>
      </p>

      <div class="actions">
        <a class="btn btn-primary" href="/projects/">See my work</a>
        <a class="btn" href="/cv.pdf">View CV</a>
      </div>
    </div>

    <!-- the work: the dashboard's scans in its window, and its result beneath -->
    <div class="min-w-0 lg:col-span-7">
      <a
        href={href}
        class="shot-link block overflow-hidden rounded-xs border border-solid border-edge bg-sunken bg-none p-0 transition-colors duration-200 hover:border-line motion-reduce:transition-none"
      >
        <span
          class="flex h-[1.9rem] items-center gap-[2.6rem] border-0 border-b border-solid border-edge bg-surface px-[0.85rem] max-[460px]:gap-[2.1rem] max-[460px]:px-[0.6rem]"
          aria-hidden="true"
        >
          <span class="dots size-[0.45rem] flex-none rounded-full bg-line"></span>
          <span class="truncate font-mono text-xs text-muted">{project?.data.repo}</span>
        </span>
        <Image
          src={scans}
          alt={scansAlt}
          widths={[420, 640, 900, scans.width]}
          sizes="(max-width: 1023px) calc(100vw - 3rem), 590px"
          loading="eager"
          fetchpriority="high"
          class="block h-auto w-full"
        />
        <!-- the link is named by what it shows, then where it goes -->
        <span class="sr-only">Read the write-up for {project?.data.title}.</span>
      </a>

      {
        results && (
          <div class="mt-6">
            <ResultBars rows={results.rows} max={results.max} label={results.label} />
          </div>
        )
      }

      <!-- four facts: the figure, then what it counts -->
      <dl
        class="m-0 mt-7 grid grid-cols-2 gap-x-8 gap-y-5 border-0 border-t border-solid border-edge pt-6 sm:max-lg:grid-cols-4"
      >
        {
          facts.map((f) => (
            <div class="flex min-w-0 flex-col-reverse">
              <dt class="font-mono text-xs text-muted">{f.label}</dt>
              <dd class="m-0 font-mono text-xl font-bold tracking-tight text-ink tabular-nums">
                {f.value}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  /* Scanlines across the masthead, the full width of the window. They sit
     under the text's own layer, so they never cut through a link. */
  .hero::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 100vw;
    margin-left: -50vw;
    z-index: 0;
    pointer-events: none;
    background-image: repeating-linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.11) 0 1px,
      transparent 1px 3px
    );
  }

  /* Misregistered colour channels, the way a bad signal prints them. Static,
     and small enough that it reads as print rather than as damage. */
  .name {
    text-shadow:
      -0.022em 0 0 rgba(255, 60, 40, 0.42),
      0.022em 0 0 rgba(40, 220, 255, 0.34);
  }
  /* The name arrives a letter at a time, once. */
  .ch {
    display: inline-block;
    animation: appear 0.45s ease-out both;
    animation-delay: calc(var(--c, 0) * 26ms + 150ms);
  }
  /* A full monospace space is very wide at display sizes, so the word gap
     is trimmed by hand. */
  .gap {
    width: 0.42em;
  }
  /* The surname takes the accent, the way Music Musings splits its own
     wordmark. */
  .accent {
    color: var(--accent);
  }
  @keyframes appear {
    from {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ch {
      animation: none;
    }
  }

  /* the window's three dots: one dot and two copies of it */
  .dots {
    box-shadow:
      0.8rem 0 0 var(--line),
      1.6rem 0 0 var(--line);
  }
</style>
