---
// A project's screenshots and drawings: one large slide in a window frame,
// with the rest as a strip of thumbnails beneath it. Picking a thumbnail
// swaps the slide; clicking a screenshot opens it full size.
//
// Every slide is in the page's HTML. The drawn slides are worked out when
// the site is built, so they are real pictures before any script runs; the
// script only makes them respond to the pointer. Without script, the slides
// simply stack, each with its caption.
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import "../styles/diagrams.css";
import { GRAPHS } from "../scripts/diagrams.js";

interface Shot {
  image?: ImageMetadata;
  graph?: string;
  alt: string;
  caption: string;
  label: string;
}
interface Props {
  shots: Shot[];
  /** The text in the window's title bar: the repository. */
  title: string;
  /** The window's shape, as "width / height". */
  ratio: string;
  /** Unique on the page, so drawings do not share ids. */
  id: string;
}
const { shots, title, ratio, id } = Astro.props;

const slides = await Promise.all(
  shots.map(async (shot, i) => {
    const spec = shot.graph ? GRAPHS[shot.graph]?.() : undefined;
    return {
      ...shot,
      svg: spec?.build(`${id}-g${i}`, shot.alt, true),
      mini: spec?.build(`${id}-t${i}`, "", false),
      // the picture at its real size, for the full-size view
      full: shot.image
        ? (await getImage({ src: shot.image, width: shot.image.width })).src
        : undefined,
    };
  }),
);
---

<div class="gallery" data-gallery>
  {
    slides.map((s, i) => (
      <figure class="slide" data-slide={i} hidden={i !== 0}>
        <div class="shot">
          <div class="shot-chrome" aria-hidden="true">
            <span class="shot-title">{title}</span>
          </div>
          {s.image ? (
            <button
              type="button"
              class="zoom"
              style={`aspect-ratio:${ratio}`}
              aria-label={`Enlarge: ${s.caption}`}
              data-full={s.full}
              data-alt={s.alt}
              data-caption={s.caption}
            >
              <Image
                src={s.image}
                alt={s.alt}
                widths={[480, 760, 1032, s.image.width]}
                sizes="(max-width: 1080px) calc(100vw - 3rem), 1032px"
                loading={i === 0 ? "eager" : "lazy"}
                fetchpriority={i === 0 ? "high" : "auto"}
              />
            </button>
          ) : (
            <div class="graph-scroll">
              <div
                class="dg-svg dg-green"
                data-graph={s.graph}
                data-idle={s.caption}
                set:html={s.svg}
              />
            </div>
          )}
        </div>
        <figcaption class="caption" data-caption role={s.graph ? "status" : undefined}>
          {s.caption}
        </figcaption>
      </figure>
    ))
  }

  {
    slides.length > 1 && (
      <div class="thumbs" role="group" aria-label="Screenshots and diagrams" data-thumbs>
        {slides.map((s, i) => (
          <button
            type="button"
            class="thumb"
            aria-pressed={i === 0 ? "true" : "false"}
            data-thumb={i}
          >
            {s.image ? (
              <Image src={s.image} alt="" width={320} loading="lazy" />
            ) : (
              <div class="thumb-graph dg-green" aria-hidden="true" set:html={s.mini} />
            )}
            <span class="thumb-label">{s.label}</span>
            <span class="sr-only">: show this slide</span>
          </button>
        ))}
      </div>
    )
  }

  <dialog class="lightbox" data-lightbox>
    <button type="button" class="lightbox-close" aria-label="Close image" data-close>
      &times;
    </button>
    <img class="lightbox-img" src="" alt="" data-lightbox-img />
    <p class="lightbox-caption" data-lightbox-caption></p>
  </dialog>
</div>

<!-- Without script the thumbnails cannot switch slides, so they are put
     away and every slide is shown, one under another. The thumbnails are in
     the page from the start, so nothing below them moves when the script
     arrives. -->
<noscript>
  <style>
    .gallery .slide[hidden] {
      display: block !important;
      margin-top: 2rem;
    }
    .gallery [data-thumbs] {
      display: none;
    }
  </style>
</noscript>

<script>
  document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((root) => {
    const slides = Array.from(root.querySelectorAll<HTMLElement>("[data-slide]"));
    const thumbs = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-thumb]"),
    );

    // Drawn slides: hover, focus or click a node and its caption explains
    // it. The drawing code is only fetched the first time one is opened.
    const wired = new WeakSet<HTMLElement>();
    async function wire(slide: HTMLElement) {
      const host = slide.querySelector<HTMLElement>("[data-graph]");
      const caption = slide.querySelector<HTMLElement>("[data-caption]");
      if (!host || !caption || wired.has(host)) return;
      wired.add(host);
      const { GRAPHS, wireGraph } = await import("../scripts/diagrams.js");
      const make = GRAPHS[host.dataset.graph ?? ""];
      if (make) {
        wireGraph(host, make(), (text) => (caption.textContent = text), host.dataset.idle ?? "");
      }
    }

    // thumbnails: one slide showing at a time
    thumbs.forEach((thumb, i) => {
      thumb.addEventListener("click", () => {
        slides.forEach((s, n) => (s.hidden = n !== i));
        thumbs.forEach((t, n) => t.setAttribute("aria-pressed", String(n === i)));
        wire(slides[i]);
      });
    });
    // a gallery that opens on a drawing, or has only one
    if (slides[0]) wire(slides[0]);

    // screenshots: open full size
    const box = root.querySelector<HTMLDialogElement>("[data-lightbox]");
    const img = root.querySelector<HTMLImageElement>("[data-lightbox-img]");
    const cap = root.querySelector<HTMLElement>("[data-lightbox-caption]");
    if (box && img && cap) {
      root.querySelectorAll<HTMLButtonElement>(".zoom").forEach((zoom) => {
        zoom.addEventListener("click", () => {
          img.src = zoom.dataset.full ?? "";
          img.alt = zoom.dataset.alt ?? "";
          cap.textContent = zoom.dataset.caption ?? "";
          if (typeof box.showModal === "function") box.showModal();
          else window.open(img.src, "_blank", "noopener");
        });
      });
      box.querySelector("[data-close]")?.addEventListener("click", () => box.close());
      // a click on the dimmed page around the picture closes it
      box.addEventListener("click", (e) => {
        if (e.target === box) box.close();
      });
    }
  });
</script>

<style>
  .gallery {
    margin: 0;
  }
  .slide {
    margin: 0;
  }

  /* The window frame */
  .shot {
    border: 1px solid var(--border);
    border-radius: 2px;
    background: var(--sunken);
    overflow: hidden;
  }
  .shot-chrome {
    display: flex;
    align-items: center;
    height: 1.9rem;
    padding: 0 0.85rem;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }
  .shot-chrome::before {
    content: "";
    flex: none;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--line);
    box-shadow:
      0.8rem 0 0 var(--line),
      1.6rem 0 0 var(--line);
  }
  .shot-title {
    margin-left: 2.6rem;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* A screenshot, at the window's fixed shape so the page does not jump
     between slides, and never cropped. */
  .zoom {
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
  }
  .zoom :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .zoom:focus-visible {
    outline-offset: -3px;
  }

  /* A drawing has a minimum legible width. On a phone it scrolls sideways
     inside the window rather than shrinking its labels to nothing. */
  .graph-scroll {
    overflow-x: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--line) transparent;
  }
  .graph-scroll :global(svg) {
    display: block;
    width: 100%;
    min-width: 720px;
    height: auto;
  }

  .caption {
    margin: 0.7rem 0 0;
    min-height: 1.5em; /* a drawing's caption changes; this stops the jump */
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--muted);
  }

  /* The strip */
  .thumbs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
    gap: 0.6rem;
    margin: 0.9rem 0 0;
  }
  .thumb {
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 2px;
    background: var(--sunken);
    color: var(--muted);
    font: inherit;
    overflow: hidden;
    cursor: pointer;
    transition: border-color 0.2s ease;
  }
  .thumb:hover {
    border-color: var(--line);
    color: var(--text);
  }
  .thumb:active {
    transform: translateY(1px);
  }
  .thumb[aria-pressed="true"] {
    border-color: var(--accent);
    color: var(--accent);
  }
  .thumb :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: contain;
  }
  /* a word under each thumbnail, so they can be told apart before opening */
  .thumb-label {
    display: block;
    padding: 0.3rem 0.45rem;
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    line-height: 1.3;
    text-align: left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* The full-size view */
  .lightbox {
    position: relative;
    max-width: min(96vw, 1100px);
    max-height: 92vh;
    padding: 0;
    border: none;
    background: transparent;
    color: #fff;
    overflow: visible;
  }
  .lightbox::backdrop {
    background: rgba(0, 0, 0, 0.88);
  }
  .lightbox-img {
    width: 100%;
    max-height: 80vh;
    object-fit: contain;
    border-radius: 2px;
  }
  /* Sits over the dimmed page, so it carries its own contrast */
  .lightbox-caption {
    max-width: 44rem;
    margin: 0.85rem auto 0;
    text-align: center;
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: #f4f4f5;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.95);
  }
  .lightbox-close {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgba(255, 255, 255, 0.38);
    border-radius: 2px;
    background: rgba(10, 10, 10, 0.72);
    color: #fff;
    font: inherit;
    font-size: var(--fs-lg);
    line-height: 1;
    cursor: pointer;
  }
  .lightbox-close:hover {
    background: rgba(10, 10, 10, 0.95);
  }
  .lightbox-close:active {
    transform: translateY(1px);
  }

  @media (max-width: 460px) {
    /* a phone has just enough room for a repo path if the bar gives up some */
    .shot-chrome {
      padding: 0 0.6rem;
    }
    .shot-title {
      margin-left: 2.1rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .thumb {
      transition: none;
    }
  }
</style>
