---
// The frame every page sits in: the document head, the skip link, the
// status bar, the page itself, previous and next, and the footer.
import "@fontsource-variable/jetbrains-mono/wght.css";
import "@fontsource-variable/ibm-plex-sans/wght.css";
// The two files nearly every visitor needs, fetched early so the text does
// not sit in a fallback face while the stylesheet is still being read.
import monoFont from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url";
import sansFont from "@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url";
import "../styles/palettes.css";
import "../styles/global.css";
import "../styles/tailwind.css"; // last, so a utility beats a plain element rule

import StatusBar from "../components/StatusBar.astro";
import Pager from "../components/Pager.astro";
import Footer from "../components/Footer.astro";
import { site, pages, type PageId } from "../data/site";

interface Props {
  /** Which status-bar window this page belongs to. A page outside the
      numbered set, such as the 404, leaves it out. */
  page?: PageId;
  /** The tab title. Left out, the page's name from the page list is used. */
  title?: string;
  /** The search and link-preview description. Defaults to the site's. */
  description?: string;
  /** Ask search engines to leave this page out: previews, the 404. */
  noindex?: boolean;
}

const { page, description = site.description, noindex = false } = Astro.props;
const entry = pages.find((p) => p.id === page);
const pageTitle = Astro.props.title ?? entry?.title ?? "";
const fullTitle = pageTitle ? `${pageTitle} | ${site.name}` : site.title;

// Link previews need absolute addresses; both come from `site` in
// astro.config.mjs.
const canonical = new URL(Astro.url.pathname, Astro.site);
const preview = new URL("/preview.jpg", Astro.site);
---

<!doctype html>
<html lang="en-GB" data-page={page}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={preview} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.previewAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href={monoFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />

    <meta name="theme-color" content="#0c1214" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <StatusBar current={page} />

    <main id="main">
      <slot />
      {page && <Pager current={page} />}
    </main>

    <Footer />

    <script>
      // Keyboard shortcuts: a digit picks a page, n and p step to the next
      // and the previous. They can be switched off, and the choice is
      // remembered, because single-key shortcuts get in the way of anyone
      // dictating to their computer.
      const KEY = "shortcuts";
      const links = Array.from(
        document.querySelectorAll<HTMLAnchorElement>("#tmux .tw"),
      );
      const hint = document.querySelector<HTMLElement>("[data-keys]");
      const toggle = document.querySelector<HTMLButtonElement>(
        "[data-keys-toggle]",
      );

      let enabled = true;
      try {
        enabled = localStorage.getItem(KEY) !== "off";
      } catch {
        // storage is blocked: the shortcuts stay on for this visit
      }

      function show() {
        if (!hint || !toggle) return;
        hint.hidden = false;
        hint.classList.toggle("is-off", !enabled);
        toggle.setAttribute("aria-pressed", String(enabled));
        toggle.textContent = enabled ? "shortcuts on" : "shortcuts off";
      }
      show();

      toggle?.addEventListener("click", () => {
        enabled = !enabled;
        try {
          localStorage.setItem(KEY, enabled ? "on" : "off");
        } catch {
          // nothing to remember it in
        }
        show();
      });

      document.addEventListener("keydown", (e) => {
        if (!enabled || e.defaultPrevented) return;
        if (e.metaKey || e.ctrlKey || e.altKey) return;
        const t = e.target as HTMLElement | null;
        if (t && /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName)) return;
        if (t && t.isContentEditable) return;
        if (document.querySelector("dialog[open]")) return;

        const at = links.findIndex(
          (a) => a.getAttribute("aria-current") === "page",
        );
        let to = -1;
        if (/^[1-9]$/.test(e.key)) to = Number(e.key) - 1;
        else if (e.key === "n") to = at + 1;
        else if (e.key === "p") to = at - 1;
        if (to < 0 || to >= links.length || to === at) return;
        window.location.assign(links[to].href);
      });
    </script>
  </body>
</html>
